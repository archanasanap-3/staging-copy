# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- DEPENDENCIES ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- NEXT.JS / BUILD OUTPUT ---
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- ENV / SECRETS ---
# Never commit these - they contain API keys/secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env.local

# --- LOGS & DEBUG ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.out.log
server.log

# --- OS / IDE JUNK ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem
.claude/
.z-ai-config

# --- PROJECT SPECIFIC ---
# Removed 'local-*' and 'prompt' as these may conflict with your source folders
# Added specific ignores for Vercel and testing
.vercel
/coverage/